# Copy to .env (git-ignored). `npx prisma dev` prints a local database URL to use here.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# The local `prisma dev` server accepts one connection at a time: keep this at 1 for it.
# Leave empty for a real Postgres server (default pool size 10).
DATABASE_POOL_MAX=1

# A SEPARATE, disposable database for `npm test` (the tests create and delete data).
# e.g. start a second local server with: npx prisma dev --name ros-test --detach
TEST_DATABASE_URL=""

# Clerk authentication. Leave empty to run locally as a shared demo user.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Verifies Clerk webhooks (user created/updated/deleted). Required outside development.
CLERK_WEBHOOK_SECRET=""

# Only for a deliberately public demo with throwaway data: allows the shared demo
# user in production. Never set this on a real deployment.
ALLOW_DEMO_MODE=""
